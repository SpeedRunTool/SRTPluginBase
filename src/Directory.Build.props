<Project>
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Platforms>AnyCPU</Platforms>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
	</PropertyGroup>

	<!--
	  Give $(Configuration) a value before OutputPath below consumes it. Directory.Build.props is
	  imported before the SDK applies its own Debug default, so otherwise $(Configuration) expands to
	  an empty string and output lands in bin
et10.0 rather than bin\Debug
et10.0 - with Debug and
	  Release then overwriting each other in the same directory.
	-->
	<PropertyGroup>
		<Configuration Condition="'$(Configuration)'==''">Debug</Configuration>
	</PropertyGroup>

	<PropertyGroup>
		<Company>SpeedRunTool</Company>
		<Authors>$(Company)</Authors>
		<CopyrightYear>$([System.DateTime]::UtcNow.ToString("yyyy"))</CopyrightYear>
		<Copyright>Copyright © $(CopyrightYear) $(Company)</Copyright>
		<!-- Was $(CompanyName), which is never defined anywhere - the URL silently lost its owner. -->
		<RepositoryUrl>https://github.com/$(Company)/SRTPluginBase</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageProjectUrl>$(RepositoryUrl)</PackageProjectUrl>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageTags>srt;srthost;speedrun;plugin</PackageTags>
	</PropertyGroup>

	<!--
	  Version for the whole repo. SRTPluginBase has only ever published pre-releases (4.0.x-beta and
	  one 5.0.0-beta), so 5.0.0 will be its first stable - and it deliberately matches the SRT Host
	  major, so host major == contract generation == package major.

	  Stays a pre-release until the ported plugins actually run against it; nuget.org does not allow
	  unpublishing, and the first stable is a one-way door. CI overrides these.
	-->
	<PropertyGroup>
		<Version>5.0.0-alpha.4</Version>
		<FileVersion>5.0.0.0</FileVersion>
		<AssemblyVersion>5.0.0.0</AssemblyVersion>
	</PropertyGroup>

	<PropertyGroup>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
		<IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<OutputPath>bin\$(Configuration)</OutputPath>
	</PropertyGroup>

	<!--
	  Pack on every build, into the repo-root artifacts\ folder that SRTHost's nuget.config consumes
	  as a local feed.

	  Packing is otherwise a separate step nobody remembers, and forgetting it is invisible rather
	  than loud: SRTHost keeps restoring the last version NuGet extracted into %USERPROFILE%\.nuget\
	  packages and builds green against contracts that no longer match the source next door.

	  Which brings up the limit of this, and it is worth knowing before trusting it. NuGet caches an
	  extracted package by *version*, so republishing 5.0.0-alpha.4 with different content changes
	  nothing downstream - the cached copy still wins, whatever is sitting in artifacts\. Repacking is
	  only picked up after either bumping the version or deleting
	  %USERPROFILE%\.nuget\packages\srtpluginbase\<version>. To iterate on the contracts themselves,
	  build the host with -p:SRTUseLocalContracts=true, which references these projects directly and
	  takes packaging out of the loop entirely.

	  Configuration is deliberately not part of the package version, so a Debug build and a Release
	  build write the same file name and the last one wins. That is fine for a local feed - the API is
	  identical either way - but it does mean artifacts\ reflects whatever was built most recently.
	-->
	<PropertyGroup>
		<GeneratePackageOnBuild>true</GeneratePackageOnBuild>
		<PackageOutputPath>$(MSBuildThisFileDirectory)..\artifacts\</PackageOutputPath>
	</PropertyGroup>

	<!--
	  Was set unconditionally, which made every local build claim to be a CI build and pin
	  deterministic source paths that only make sense on the build agent.
	-->
	<PropertyGroup Condition="'$(GITHUB_ACTIONS)'=='true'">
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Debug'">
		<DefineConstants>$(DefineConstants);DEBUG;TRACE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
		<None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
	</ItemGroup>

	<!--
	  Pinned to the SDK's own band (10.0.4xx), and it has to stay at a patched version.
	
	  CVE-2026-62900 / GHSA-23fw-v26w-5fgq is in the transitive Microsoft.Build.Tasks.Git and covers
	  8.0.0, 10.0.102-10.0.110, 10.0.200-10.0.204 and 10.0.300-10.0.301; the fixes are 10.0.111 and
	  10.0.303, and the 10.0.2xx band was never patched. NuGet audit reports it as NU1902, which is an
	  error here because TreatWarningsAsErrors is on - so a build failing on this means the pin has
	  fallen into an affected range, not that the package should be dropped.
	
	  The .NET SDK has carried SourceLink in-box since 8.0 and suppresses its own copy whenever a
	  Microsoft.SourceLink.* package is referenced, which is why the package still ships and still
	  gets 10.x releases per SDK band (and 11.x previews): the SDK ingests those packages, and a
	  build that is not using the .NET SDK, or is on an SDK older than its repo needs, still
	  references them directly. Keeping the reference means the version is stated here rather than
	  inherited from whichever SDK happens to be installed.
	-->
	<ItemGroup>
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
	</ItemGroup>
</Project>
